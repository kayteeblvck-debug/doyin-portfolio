# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values you need.
#
#     cp .env.example .env.local
#
# The site runs with NONE of these set — reviews save to a local SQLite file
# and emails print to your terminal. Fill these in when you want real email
# and a real deployment.
#
# .env.local is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------


# --- Where notifications go ------------------------------------------------
NOTIFY_EMAIL=omololaa226@gmail.com


# --- Email delivery: pick ONE of the two options below ---------------------

# OPTION 1 — SMTP (recommended; works with Gmail or your own domain)
#
# Gmail needs an "app password" — your normal account password will not work.
# Turn on 2-Step Verification first, then:
#   Google Account → Security → 2-Step Verification → App passwords
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=omololaa226@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=omololaa226@gmail.com


# OPTION 2 — Resend (https://resend.com, free tier available)
# Requires a verified sending domain for MAIL_FROM.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=hello@yourdomain.com


# --- Review moderation -----------------------------------------------------

# Admin token for /admin — needed to hide or delete reviews.
# Generate a strong one with:  openssl rand -hex 24
# Leave unset and the admin endpoints stay closed entirely.
# ADMIN_TOKEN=

# Set to true to hold new reviews until you approve them at /admin.
# Default (unset) publishes reviews immediately.
# REVIEWS_REQUIRE_APPROVAL=false


# --- Database --------------------------------------------------------------

# Leave DATABASE_URL unset to use the built-in SQLite file at ./data/portfolio.db.
# That works locally and on any host with a persistent disk.
#
# REQUIRED on serverless hosts such as Vercel, where the filesystem is wiped
# between requests and SQLite data would not survive.
#
# DATABASE_URL=postgres://user:password@host:5432/database


# --- Privacy ---------------------------------------------------------------

# Salt used when hashing visitor IPs for rate limiting. Raw IPs are never
# stored. Set any random string in production:  openssl rand -hex 16
# IP_HASH_SALT=
